{
  "name": "ai-agent",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace @monorepo/backend run dev",
    "dev:frontend": "npm --workspace @monorepo/frontend run dev",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build:backend": "npm --workspace @monorepo/backend run build",
    "build:frontend": "npm --workspace @monorepo/frontend run build",
    "build": "concurrently \"npm:build:backend\" \"npm:build:frontend\"",
    "start:backend": "npm --workspace @monorepo/backend run start",
    "start:frontend": "npm --workspace @monorepo/frontend run start:client",
    "start": "concurrently \"npm:start:backend\" \"npm:start:frontend\"",
    "format": "prettier --write \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "prettier": "^3.3.3",
    "shadcn": "^3.5.0",
    "typescript": "^5.3.3"
  }
}
